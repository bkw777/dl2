; TINY/TEENY asm source
; TINY originally by Ed Giese of Acroatix.
; TEENY is TINY that Ron Weisen made a bit smaller and batch-drivable.
; Originally based on a disassembly of TEENY for Model 100.
; This version no longer aims to reproduce the legacy binary.
; Platform & rom references for porting: https://github.com/bkw777/m100_dev
; Brian K. White
;
; build with z88dk-z80asm
;
; 0 - Use the nightly version of z88dk, else include "-DZ88DK=1" on all z80asm commands.
; Include "-DMODEL_XXXXX" on all z80asm commands: 100na K85na M10na M10eu 200na NECna
;
; 1 - Build once without -DPRGLEN=n, note the length in bytes of the generated TEENY.CO
; z88dk-z80asm -m8085_strict -no-synth -DMODEL_100na -b -o=TEENY.CO TEENY.S85
;
; 2 - Finally repeat the same build, with -DPRGLEN=nbytes this time.
; z88dk-z80asm -m8085_strict -no-synth -DMODEL_100na -DPRGLEN=626 -b -o=TEENY.CO TEENY.S85

;;;;
;;;; 100na works
;;;; M10na works
;;;; M10eu works
;;;; K85na works
;;;; 200na does not work, but ../orig/disasm/TNY200.S85 does
;;;; NECna does not work, but ../orig/disasm/TNYNEC.S85 does
;;;;

; -----------------------------------------------------------------------------
; CONFIGURATION
; -----------------------------------------------------------------------------

; BAUD
; TPDD1 default is 19200 but dip switch settable 150-76k.
; TPDD2 is 19200 only. (not even solder-jumper option)
; Brother FB-100, KnitKing FDD19, and Purple Computing D103 are 9600 only.
; (actually settable 150-76k like TPDD1, but only via solder jumpers)
; System rom max is 19200.
	IFNDEF BAUD
BAUD 				EQU		19200
	ENDIF

; DSR
; Include code to check DSR to avoid hangs and fail more gracefully
; when the drive is powered off or the serial connection breaks.
; It's nice and only adds about a dozen bytes, but it makes it far more
; picky about serial cables. Without the DSR check you can use practically
; any cable, even 3-wire.
	;DEFINE DSR

; ERRCODES
; Include code to manage distinct error codes and messages for different
; events and conditions, and parse the error codes returned by the drive.
	;DEFINE ERRCODES

; ROM
; If building to embed in a ROM then don't use any self-modifying code.
	;DEFINE ROM

; CHUNK_LEN
; length of WRITE packet data field
; It should technically be variable, and maybe one day it will be,
; but for now don't try to change it from 128.
	IFNDEF CHUNK_LEN
CHUNK_LEN			EQU		128			; 1-128
	ENDIF

COM_SETUP_PAUSE_MS	EQU		100

; -----------------------------------------------------------------------------
; ASSEMBLER
; -----------------------------------------------------------------------------

; z88dk before v24830 (db5c165 20260603) doesn't know the intel syntax for RST.
; "-DZ88DK=version" is generated in Makefile.
_RST MACRO n
	IF Z88DK && Z88DK<24830
		RST n*8
	ELSE
		RST n
	ENDIF
	ENDM

; -----------------------------------------------------------------------------
; TARGET PLATFORM
; -----------------------------------------------------------------------------

	IF MODEL_200na
	INCLUDE		"200na.S85"
	ELIF MODEL_NECna
	INCLUDE		"NECna.S85"
	ELIF MODEL_K85na
	INCLUDE		"K85na.S85"
	ELIF MODEL_M10na
	INCLUDE		"M10na.S85"
	ELIF MODEL_M10eu
	INCLUDE		"M10eu.S85"
	ELSE
	INCLUDE		"100na.S85"
	ENDIF

	IFNDEF FLOWCTL_PORT
FLOWCTL_PORT		EQU		0xBB		; COM & LPT flow control bits
	ENDIF
	IFNDEF DSR_BITMASK
DSR_BITMASK			EQU		0x20
	ENDIF

; COM STAT speed
	IF BAUD = 75
	COM_SPEED EQU '1'
	ELIF BAUD = 110
	COM_SPEED EQU '2'
	ELIF BAUD = 300
	COM_SPEED EQU '3'
	ELIF BAUD = 600
	COM_SPEED EQU '4'
	ELIF BAUD = 1200
	COM_SPEED EQU '5'
	ELIF BAUD = 2400
	COM_SPEED EQU '6'
	ELIF BAUD = 4800
	COM_SPEED EQU '7'
	ELIF BAUD = 9600
	COM_SPEED EQU '8'
	ELSE
	COM_SPEED EQU '9'					; default 19200
	ENDIF

; COM STAT parameters
; 8 bit, disable xon/xoff   (TPDD protocol has binary data)
	IFNDEF COM_PARAMS
COM_PARAMS MACRO
	DB "8N1D"
	ENDM
	ENDIF

; COM STAT string ex: "98N1D"
COM_STAT MACRO
	DB COM_SPEED
	COM_PARAMS
	ENDM

; cpu opcodes
opcode_LXI_B		EQU		0x01

; ascii
ETX					EQU		0x03
LF					EQU		0x0A
FF					EQU		0x0C
CR					EQU		0x0D
ESC 				EQU		0x1B
SPACE				EQU		0x20

; MKDIRENT file type attributes
fattrBA				EQU		0x80		; .BA files
fattrDO				EQU		0xC0		; .DO files
fattrCO				EQU		0xA0		; .CO files
; file types, reg A for AFTEREOF2
ftypeBA				EQU		0x00
ftypeDO				EQU		0x01
ftypeCO				EQU		0x02

rst_NextNonSpace	EQU		2			; RST 2 = get next non-whitespace char from M to A
rst_CompareDEHL		EQU		3			; RST 3 = compare DE and HL
rst_Print_A			EQU		4			; RST 4 = print A to LCD/LPT

local_fname_len		EQU		9			; XXXXXX.XX
FX1					EQU		FILNM1+6	; EXT of FILNM1 after CKFN2 (“CO”, “DO”, “BA”)

; -----------------------------------------------------------------------------
; TPDD
; -----------------------------------------------------------------------------

ZZ					EQU		0x5A5A		; packet start / preamble, "ZZ"

hard_coded_attr		EQU		'F'

; commands
cmd_dirent			EQU		0x00
cmd_open			EQU		0x01
cmd_close			EQU		0x02
cmd_read			EQU		0x03
cmd_write			EQU		0x04
cmd_delete			EQU		0x05
cmd_status			EQU		0x07

; returns
ret_read			EQU		0x10
ret_dirent			EQU		0x11
ret_std				EQU		0x12

; dirent actions
dirent_set_name		EQU		0x00

; file open modes
write_mode			EQU		0x01
append_mode			EQU		0x02
read_mode			EQU		0x03

tpdd_fname_len		EQU		24
cmd_dirent_dlen		EQU		tpdd_fname_len + 1 + 1	; 24(fname) + 1(attr) +1(action)
pkt_len_overhead	EQU		5	; 2(ZZ) + 1(fmt) + 1(len) + 1(chk)

; -----------------------------------------------------------------------------
; APPLICATION
; -----------------------------------------------------------------------------

; TINY uses ALTLCD for it's variables and packet buffer
; start of ALTLCD (model 100 na)				; FCC0

RamFileStart		EQU		ALTLCD
RamFileSize			EQU		RamFileStart + 2
DskFileSize			EQU		RamFileSize + 2		; native lsb-first copy of tpdd msb-first filesize
	IF ROM
initial_sp			EQU		DskFileSize + 2		; initial stack pointer
LoadingFlag			EQU		initial_sp + 2		; >0 while LOAD in progress
	ELSE
initial_sp			EQU		MAIN@sp + 1			; initial stack pointer
LoadingFlag			EQU		DskFileSize + 2
	ENDIF
; TPDD packet
pktZZ				EQU		LoadingFlag + 2		; tpdd packet preamble "ZZ"
pktTYPE				EQU		pktZZ + 2			; tpdd packet type, cmd_xxx or ret_xxx
pktDLEN				EQU		pktTYPE + 1			; tpdd packet data length, 0-128
pktDATA				EQU		pktDLEN + 1			; tpdd packet data, 0-128 bytes, +1 checksum byte

; filesize field within a DIRENT return packet
; pktDATA +  0 : fname
; pktDATA + 24 : attr
; pktDATA + 25 : fsize msb
; pktDATA + 26 : fsize lsb
direntFSIZE			EQU		pktDATA + tpdd_fname_len + 1

;              start of data + data len + checksum byte
; end of packet buffer		pktDATA + CHUNK_LEN + 1

; end of ALTLCD				ALTLCD + 0x013F		; FDFF


; -----------------------------------------------------------------------------
; ORG & CO header
; -----------------------------------------------------------------------------

; For a .CO file, ORG needs to be calculated backwards from HIMEM-PRGLEN.
;
; The only way to determine PRGLEN is to build without caring what the
; addresses are, note the length, and build again with -DPRGLEN=length.
;
; For a temp build just to get the length, don't specify PRGLEN, HIMEM, or ORG
; For a .CO file just below MAXRAM on a 32k machine, specify -DPRGLEN=length
; For a .CO file just below a given HIMEM, specify -DHIMEM=addr -DPRGLEN=length
; For a binary that will be included in a rom, specify -DROM -DORG=addr

	; If no -DPRGLEN then don't set ORG and don't include a CO header.
	; If -DORG then override PRGLEN & HIMEM (ignore them)
	IF ORG
	ORG ORG
	ELSE
	IFDEF PRGLEN
	;--------------------------------------------------------------------------
	; ORG
	;--------------------------------------------------------------------------
	IFNDEF HIMEM
HIMEM				EQU		MAXRAM
	ENDIF ; !HIMEM

	ORG HIMEM-PRGLEN-6					; entry minus length of header

	;--------------------------------------------------------------------------
	; .CO HEADER
	;--------------------------------------------------------------------------
	DW PRGTOP
	DW PRGLEN
	DW PRGEXE
	ENDIF ; PRGLEN
	ENDIF ; !ORG
;------------------------------------------------------------------------------


; -----------------------------------------------------------------------------
; START
; -----------------------------------------------------------------------------

;------------------------------------------------------------------------------
PRGTOP:
PRGEXE:
		LDSI		0					; DE = stack pointer+0
		XCHG							; HL = stack pointer
		SHLD		initial_sp			; [initial_sp] = stack pointer
		LXI			H,ZZ				; HL = "ZZ" = tpdd packet preamble
		SHLD		pktZZ				; [pktZZ] = "ZZ" preamble field of packet buffer never changes
MAIN:
		; reset stack pointer every time we return to main
	IF ROM
		LHLD		initial_sp			; HL = [initial_sp]
		SPHL							; SP = HL = saved initial stack pointer
	ELSE
@sp:	LXI			SP,0*initial_sp		; SP = [initial_sp]
	ENDIF
		XRA			A					; A = 0
		STA			LoadingFlag			; [LoadingFlag] = A = 0
		LXI			H,MAIN				; HL = MAIN
		PUSH		H					; TS = MAIN
		LXI			H,STR_Prompt		; HL = STR_Prompt
		CALL		PTILL0				; print HL
		; we just printed the prompt
		; now collect the user input
		STA			KYBCNT				; [KYBCNT] = A = 0 (clear pending keystrokes count)
		CALL		INLIN				; get a line of input from keyboard
		; KYBUF = |L MYPROG.BA|
		LXI			H,errSN				; HL = errSN
		SHLD		ETRAP				; [ETRAP] = errSN  set errSN as the ON ERROR handler
		LXI			H,KYBUF+1			; HL = KYBUF+1
		MVI			M,'"'				; KYBUF[1]='"'
		; KYBUF = |L"MYPROG.BA|
		; HL = KYBUF+1 (on the ")
		; CKFN2 reads it the same way BASIC reads ex: |SAVE"MYPROG.BA|
		CALL		CKFN2				; evaluate & reformat filename
		CALL		RESETFPS			; reset file pointers
		LDA			KYBUF				; A = KYBUF[0]
		CPI			'Q'					; is it 'Q' ?
		JZ			MENU				; then exit to OS (main menu)
		CPI			'S'					; is it 'S' ?
		JZ			SAVE				; then jump to SAVE

		; if we got here, cmd is K, L, or invalid

		PUSH 		PSW					; stash A = cmd
		; TS=cmd,MAIN
		; KILL and LOAD both start with DIRENT
		CALL		DIRENT      	    ; tell the drive the filename, Z if !exist
		JZ			errFF				; FF error if file not found
		; file found on disk
		POP 		PSW					; restore A = cmd
		; TS=MAIN
		SUI			'K'					; A -= 'K'
		JZ			KILL				; if A == 0 then cmd is 'K', jump to KILL
		DCR 		A					; A--
		JZ			LOAD				; if A == 0 then cmd is 'L', jump to LOAD

		; if we got here, cmd is invalid
		; fall into errSN - syntax error

; -----------------------------------------------------------------------------
; ERROR CODES - this stack of jump targets uses an opcode-as-data trick
; 1: The MVI E,eXX that you jump/fall to executes normally and sets E=eXX.
; 2: The DB opcode_LXI_B after that executes as code, consumes the next 2 bytes
;    MVI E,eXX as it's operand, which just get copied to B and ignored.
; 3: The next byte is another LXI_B, repeat 2: as long as the pattern holds.
; 4: Fall into ERROR with E=eXX. B is never used.
; -----------------------------------------------------------------------------

	IF ERRCODES
errSN:
		MVI			E,eSN				; fell from above = unknown cmd = syntax error
		DB			opcode_LXI_B
errFF:
		MVI			E,eFF
		DB			opcode_LXI_B
errUE:
		MVI			E,eUE
		DB			opcode_LXI_B
errIO:
		MVI			E,eIO
		DB			opcode_LXI_B
errWP:
		MVI			E,eWP
		DB			opcode_LXI_B
errDF:
		MVI			E,eDF
		DB			opcode_LXI_B
errND:
		MVI			E,eND
		DB			opcode_LXI_B
errHW:
		MVI			E,eHW

;		E = eXX  some error code
;		B = junk
	ELSE
	; if not including error codes, then define all the jump targets to be the
	; same as ERROR, so we don't have to have as many ifdefs everywhere else
errSN:
errFF:
errUE:
errIO:
errWP:
errDF:
errND:
errHW:
	ENDIF

; -----------------------------------------------------------------------------
; ERROR
; -----------------------------------------------------------------------------
ERROR:
		; if we were in the middle of SAVE, then undo the partial new file
		LDA 		LoadingFlag			; A = [LoadingFlag]
		ORA 		A					; does [LoadingFlag] == 0?
		JZ 			@show				; if 0 skip to @show
	IF ERRCODES
		PUSH 		D					; stash E = eXX
	ENDIF
		LHLD 		RamFileSize			; HL = [RamFileSize]  HL = ram_fsize
		MOV 		B,H					; B = H
		MOV 		C,L					; C = L   BC = ram_fsize
		LHLD 		RamFileStart		; HL = [RamFileStart]  HL = ram_fstart
		CALL		MASDEL				; delete BC bytes @ HL
	IF ERRCODES
		POP 		D					; restore E = eXX
	ENDIF
@show:
	IF ERRCODES
		LXI			H,STR_ErrCodes		; HL = start of string of err codes
		MVI			D,0					; D = 0   DE = eXX
		DAD			D					; HL = STR_Errcodes+eXX
		MOV			A,M					; get first byte of error code
		_RST		rst_Print_A			; print it
		_RST		rst_NextNonSpace	; get next byte of err code
		_RST		rst_Print_A			; print it
	ENDIF
		LXI			H,STR_Err			; get STR_Err
			CALL		PTILL0			; print it
			JMP			MAIN			; restart at main

; -----------------------------------------------------------------------------
; DIRENT - tell the drive a filename
; -----------------------------------------------------------------------------
DIRENT:
		; activate rs232
		CALL		COMOFF				; disable MDM/COM
		; original TEENY uses 0x2E -> about 100ms. make it so MS=100 produces 0x2E
		MVI        D,COM_SETUP_PAUSE_MS*100/215		; 0x2E00 timing loops
		CALL       PAUSE_DEx10us		; burn cpu for DE*10us = about 100ms
		LXI			H,STR_STAT			; HL @ STAT string ("98N1D")
		STC								; set carry flag - tells SET232 to apply to the RS232 port
		CALL		SET232				; configure uart per the stat string

		; send a STATUS packet
		MVI			A,cmd_status		; A = cmd_status
		CALL		ShortPacket			; send STATUS packet

		; send a DIRENT packet
		; 2     1   1   24           1     1       1
		; 5A5A  00  1A  filename     attr  action  chk

		; start building a DIRENT(set_name) cmd packet
		XRA			A					; A = 0 = cmd_dirent
		CALL		InitPacket			; start building a cmd_dirent packet
		; HL = pktDLEN (len)
		MVI			M,cmd_dirent_dlen	; [pktDLEN] = 26
		INX			H					; HL++
		; HL = pktDATA (start of data)
		LXI			D,KYBUF+2			; DE = 3rd byte into keyboard buffer (skip over "C ")
		MVI			B,local_fname_len	; B = 9
		CALL		D2H4Bup				; append 9 bytes (filename FFFFFF.XX) from DE (keyb buf) to HL (packet data)
		; pktDATA[0]..pktDATA[8] = "MYPROG.BA"
		; HL = pktDATA+9  end of filename + 1
		; fill the rest of the filename field with spaces
		MVI			B,tpdd_fname_len-local_fname_len	; B = 24-9 = 15
@append_space:
		MVI			M,SPACE				; [HL] = " "
		INX			H					; HL++
		DCR			B					; B--
		JNZ 		@append_space		; repeat until B=0
		; HL = pktDATA+24 = dirent attr field
		MVI 		M,hard_coded_attr	; [pktDATA+24] = 'F'
		INX			H					; next byte
		; HL = pktDATA+25 = dirent action field, code for set_name action is 0
		MOV			M,B					; [pktDATA+25] = B = 0
		; dirent(set_name) tells the drive the filename for an open/close/read/write/kill to follow

		; fall into SendPacketSpecial

; send a DIRENT or READ packet and detect which kind of return packet we get back
SendPacketSpecial:
	IF ERRCODES
		CALL		SendPacket
		; A = data[0]
		; BC = data_len
		; D = junk partial sum
		; E = 0
		; HL = pktDATA
		; pkt buffer = return packet from drive
		; Z if A=0

		MOV			B,A					; B = data[0]
		LDA			pktTYPE				; A = [pktTYPE] = ret_pkt_type
		CPI			ret_std				; is it ret_std?
		JZ			ParseStdReturn		; if it's a standard return then jump to the standard return parser
		; it's not a standard return (it's a DIRENT or READ return)
		; restore the A & Z state left by SendPacket before returning
		MOV			A,B					; A = data[0]
		ORA			A					; if A = 0 set Z

		; A = data[0]
		; B = data[0]
		; C = data_len
		; D = junk partial sum
		; E = 0
		; HL = pktDATA
		; pkt buffer = return packet from drive
		; Z if A=0

		; RET might go to:
		; * CALL SendPacketSpecial in SendReadCMD
		; * CALL DIRENT in MAIN
		RET
	ENDIF

	; fall into SendPacket if not ERRCODES

; * Calculate & append checksum to packet
; * Send the REQuest packet
; * Receive the RETurn packet
SendPacket:
		; ---------------------------------------------------------------------
		; FINISH BUILDING OUTGOING PACKET (calculate and append checksum)
		; ---------------------------------------------------------------------

		; Calculate Packet Checksum
		; Sum all the bytes in the specified range, modulo 0xFF
		; Take the least significant byte of that sum.
		; Invert all the bits in that byte.
		; The checksummed range is the start of cmd through end of data.

		; start checksum = cmd
		LXI			H,pktTYPE			; HL = pktTYPE
		MOV			A,M					; A = cmd

		; add len
		INX			H					; HL++ = pktDLEN 
		ADD			M					; A += data_len
		MOV			D,A					; D = A = sum_to_dlen
		MOV			A,M					; A = data_len
		MOV			E,A					; E = data_len
		MOV			B,A					; B = data_len
		INX			H					; HL = pktDATA
		ORA			A					; Z if len==0
		MOV			A,D					; A = D = sum_to_dlen
		JZ			@endpkt				; if len==0 then jump to finish checksum

		; add data
@add_data_to_sum:
		ADD			M					; add data byte to sum (rolls over every 0xFF) 
		INX			H					; HL++  HL @ next data byte
		DCR			E					; E--
		JNZ			@add_data_to_sum	; repeat until E=0
		; D = junk (sum_to_dlen)
		; E = 0

		; compliment & append to packet
@endpkt:
		; A = sum (mod256)
		; HL @ pktDATA+len+1
		CMA								; complement A, A = checksum
		MOV			M,A					; [pktDATA+len+1] = checksum

		; ---------------------------------------------------------------------
		; SEND OUTGOING PACKET
		; ---------------------------------------------------------------------

		; pkt_len = data_len + overhead (5)
		;      ZZ    TYPE   DLEN   DATA       CHK
		; B =  2   + 1    + 1    + data_len + 1

		MVI			A,pkt_len_overhead	; A = 5
		ADD			B					; A += B  A = pkt_len
		MOV			B,A					; B = pkt_len
		; B = loop counter for all bytes in packet, ZZ to CKSUM inclusive
		LXI			H,pktZZ				; HL @ pktZZ (0x5A5A aka "ZZ")

@send_byte:
	IF DSR
		CALL		CheckDSR
	ENDIF
		MOV			A,M					; A = byte from packet
		CALL		SND232				; send byte out rs232
		JC			errIO				; shift+break pressed
		INX			H					; HL++
		DCR			B					; B--
		JNZ			@send_byte			; repeat until B = 0
		; B = 0

		; ---------------------------------------------------------------------
		; RECIEVE RETURN PACKET
		; ---------------------------------------------------------------------

		; tpdd return packet starts with pktTYPE, no ZZ
		LXI			H,pktTYPE			; HL = pkTYPE

		; disable interrupts last thing before reading from serial
		CALL		INT1D				; disable interrupts

		CALL		RXtoM				; [pktTYPE] = A = ret_pkt_type, HL++, HL = pktDLEN
		CALL		RXtoM				; [pktDLEN] = A = data_len, HL++, HL = pktDATA
		MOV			C,A					; C = data_len
		INR			C					; C++  C = data_len+1 (data + checksum)
		; read C more bytes from serial (read data and checksum)
@rx_data:
		CALL		RXtoM				; [pktDATA++] = A = rxbyte++
		DCR			C					; C--
		JNZ			@rx_data			; repeat until C = 0

		; re-enable interrupts first thing after reading from serial
		XRA			A					; A = 0
		SIM								; IM = 0 -> enable all interrupts

		; A = 0
		; BC = 0
		; HL = pktDATA + data_len + 2  (addr of checksum + 1)
		; packet buffer now contains the complete return packet

		; ---------------------------------------------------------------------
		; VERIFY CHECKSUM   (WOULD GO HERE)
		; ---------------------------------------------------------------------



		; ---------------------------------------------------------------------
		; RETURN
		; ---------------------------------------------------------------------

		LXI			H,pktDLEN			; HL = pktDLEN
		MOV			C,M					; C = data_len   BC=data_len
		INX			H					; HL++  HL = pktDATA
		MOV			A,M					; A = data[0]
		ORA			A					; set Z if data[0] == 0

		; return packet types:
		; LOAD    0x10 read file data return, dlen=0to128, A=data[0]
		; DIRENT  0x11 dirent return, dlen=28, A=filename[0]
		; others  0x12 standard return, dlen=1, A=error_code, 0 = success
		; So for most packets we are returning A=err and setting Z if err=0
		; A & Z don't seem to be meaningful for LOAD or DIRENT ?

		; A = data[0]
		; Z = if A=0
		; BC = data_len
		; D = junk (sum_to_dlen)
		; E = 0
		; HL = pktDATA
		; pkt buffer = return packet from drive
		RET

; -----------------------------------------------------------------------------
; KILL - delete a file on disk
; -----------------------------------------------------------------------------
KILL:
		MVI			A,cmd_delete
		JMP			ShortPacket

; -----------------------------------------------------------------------------
; LOAD - copy a file from disk to ram
; -----------------------------------------------------------------------------
LOAD:
; FINDFN reads FILNM1 (FC93 on 100) which has been prepared by CKFN2 in MAIN
		CALL		FINDFN				; see if the proposed file already exists in ram
		JNZ			errFF				; destination file already exists in ram
	IF ERRCODES
		LXI			H,errDF				; HL = errDF
		SHLD 		ETRAP				; set errDF as the general error handler
	ENDIF
		CALL		SCNEMP				; find empty ram file direrctory entry
		PUSH		H					; TS=dirent_start
		; get extra_len based on file type
		CALL		RamFileExtraLen		; A = extra_len   0|1|2 for CO|DO|BA
		LHLD		direntFSIZE			; HL = [direntFSIZE] (big-endian: H=lsb L=msb)
		; direntFSIZE was written by DIRENT while still in MAIN before coming here.
		; TPDD 16-bit values are big-endian, iow msb-first: H=lsb L=msb
		; Native 16-bit values are litte-endian, iow lsb-first: H=msb L=lsb
		; byte-swap [direntFSIZE] to get fsize in usable native form.
		MOV			B,L					; B = L = disk_fsize_msb
		MOV			C,H					; C = H = disk_fsize_lsb
		; BC = disk_fsize
		MOV			L,C					; L = C = disk_fsize_lsb
		MOV			H,B					; H = B = disk_fsize_msb
		; HL = disk_fsize
		SHLD		DskFileSize			; [DskFileSize] = disk_fsize
		DCX			B					; BC-- to negate the first BC++ below
		MOV			E,A					; E = extra_len  (saving for later)
		INR			A					; A++ to negate the first A-- below
@incr_len:	; add extra_len to disk_fsize to get ram_fsize including eof bytes
		INX			B					; BC++
		DCR			A					; A--
		JNZ			@incr_len			; repeat until A=0
		; A = 0
		; BC = ram_fsize full ram file length including eof bytes
		; CO: BC = disk_fsize+0
		; DO: BC = disk_fsize+1  (0x1A)
		; BA: BC = disk_fsize+2  (0x00 0x00)
		;
		; TBL_ftypes is a table with 3 entries, one each for CO, DO, & BA filetypes
		; Each entry is 3 fields totalling 5 bytes:
		;  fattrXX      1 byte   fattr for XX filetype
		;  LOAD_End_XX  2 bytes  routine to finish writing XX filetype
		;  XXFILES      2 bytes  start of XX files area
		MOV			D,A					; D=0 E=extra_len DE=extra_len
		; all possible values of extra_len just happens to be 0,1,2
		; so it's also (ab)used as the index into TBL_ftypes
		; get the address of the start of TBL_ftypes
		LXI			H,TBL_ftypes		; HL = TBL_ftypes
		; move to the correct block for the file type
		DAD			D					; HL += DE
		DAD			D					; HL += DE
		DAD			D					; HL += DE
		DAD			D					; HL += DE
		DAD			D					; HL += DE
		; HL = TBL_ftypes + 5*DE
		; CO: DE=0 -> HL = TBL_ftypes + 0
		; DO: DE=1 -> HL = TBL_ftypes + 5
		; BA: DE=2 -> HL = TBL_ftypes + 10

		; read 1st byte of table entry & push: fattr
		; HL @ fattr field
		MOV			A,M					; A = [HL]   A = fattr
		PUSH		PSW					; TS=fattr,dirent_start

		; push MkRamDirent
		LXI			D,MkRamDirent		; DE = MkRamDirent
		PUSH		D					; TS=MkRamDirent,fattr,dirent_start

		; read next 2 bytes & push: LOAD_End_XX
		INX			H					; HL++  HL @ LOAD_End_XX field
		MOV			E,M					; E = LOAD_End_XX_lsb
		INX			H					; HL++
		MOV			D,M					; D = LOAD_End_XX_msb  DE = LOAD_End_XX
		PUSH		D					; TS=LOAD_End_XX,MkRamDirent,fattr,dirent_start

		; read next 2 bytes & push: XXFILES
		INX			H					; HL++  HL @ XXFILES field
		MOV			E,M					; E = XXFILES_lsb
		INX			H					; HL++
		MOV			H,M					; H = XXFILES_msb
		MOV			L,E					; L = XXFILES_lsb  HL = XXFILES

		; done reading TBL_ftypes

		; move HL to DE (destroys HL)
		MOV			E,M					; E = XXFILES lsb
		INX			H					; HL++
		MOV			D,M					; D = XXFILES msb  DE = XXFILES

		; store ram_fsize @ RamFileSize
		MOV			H,B					; H = ram_fsize msb
		MOV			L,C					; L = ram_fsize lsb  HL = ram_fsize
		SHLD		RamFileSize			; [RamFileSize] = ram_fsize

		; allocate ram for the new file
		XCHG							; swap HL:DE
		; DE = ram_fsize
		; HL = XXFILES = start of CO/DO/BA files area
		SHLD		RamFileStart		; [RamFileStart] = HL = start of CO/DO/BA files area = ram_fstart
		PUSH		H					; TS=ram_fstart,LOAD_End_XX,MkRamDirent,fattr,dirent_start
		CALL		MAKHOL				; allocate space for new file
		JC			errDF				; carry = failed: out of memory
		; HL = ram_fstart
		; A BC DE = junk

		; set a status flag that LOAD is currently in progress
		LXI			H,LoadingFlag		; HL = LoadingFlag
		INR			M					; [LoadingFlag]++

		; open disk file for reading
		CALL		SendOpenCMD_read	; open the tpdd file for reading
		; SendOpenCMD_read also falls through into SendReadCMD, so both
		; OPEN and the first READ have been done, and the packet buffer
		; contains the first READ_file_data return packet (not OPEN).
		; A = 0
		; BC = 0

		LHLD		DskFileSize			; HL = [DskFileSize]  HL = disk_fsize
		XCHG							; swap HL:DE  DE = disk_fsize
		POP			H					; HL = ram_fstart  TS=LOAD_End_XX,MkRamDirent,fattr,dirent_start

		; BC = 0            (chunk_progress) 0-127 incrementing count of bytes within a chunk
		; DE = disk_fsize   (remaining_len)  decrimenting count of remaining bytes in file
		; HL = ram_fstart   (ram_position)   incrimenting ram addr position in destination file
@CopyByteToRam:
		; BC = chunk_progress  (0x00-0x7F)
		; DE = remaining_fsize
		; HL = ram_position

		; set Z if remaining_fsize=0
		MOV			A,D					; A = D = remaining_fsize_lsb
		ORA			E					; A = D|E (remaining_fsize lsb|msb), iow set Z if remaining_fsize=0

		; IF ENTIRE FILE IS DONE
		; if Z then jump to LOAD_End_XX to finish
		; TS=LOAD_End_XX,MkRamDirent,fattr,dirent_start
		RZ								; when DE=0 pop & jump to LOAD_End_XX

		; IF CURRENT CHUNK IS DONE
		; (dirty ass trick to count 128, shouldn't it compare to [pktDLEN] ? )
		; if chunk_progress>127 then fetch the next chunk from the drive
		MOV			A,C					; A = C = chunk_progress    <<<<TESTING
		ORA			A					; A|A, iow set S if A > 0x7F
		CM			SendReadCMD			; call if chunk_progress > 127
		; Only if we did CM:
		;   A = 0
		;   BC = 0

		; TODO: could we use main rom D2H4Bup or D2H4Bdn instead?

		DCX			D					; DE--  remaining_fsize--
		PUSH		H					; stash HL = ram_position
		; TS=ram_position,LOAD_End_XX,MkRamDirent,fattr,dirent_start
		LXI			H,pktDATA			; HL = pktDATA
		DAD			B					; HL += BC = pktDATA + chunk_progress
		MOV			A,M					; A = [HL]  A = data[chunk_progress]
		POP			H					; HL = ram_position
		; TS=LOAD_End_XX,MkRamDirent,fattr,dirent_start
		MOV			M,A					; [ram_position] = data[chunk_progress] (copy byte from packet buffer to ram file)
		INX			H					; HL++ (ram_position++)
		INR			C					; C++ (chunk_progress++)

		JMP			@CopyByteToRam		; repeat

; LOAD-related ----------------------------------------------------------------
SendOpenCMD_read:
		MVI			E,read_mode
		CALL		SendOpenCMD
SendReadCMD:
		PUSH		H					; stash HL
		PUSH		D					; stash DE

		; start populating READ cmd packet
		MVI			A,cmd_read			; A = cmd_read, READ command packet type
		CALL		InitPacket			; start building a new packet in the packet buffer
		CALL		SendPacketSpecial	; send the packet to the drive, read the return packet from the drive, handle std vs special return

	; if ERRCODES
		; A = data[0]
		; B = data[0]
		; C = data_len
		; D = junk partial sum
		; E = 0
		; HL = pktDATA
		; pkt buffer = return packet from drive
		; Z if A=0

	; if not ERRCODES
		; A = data[0]
		; BC = data_len
		; D = junk partial sum
		; E = 0
		; HL = pktDATA
		; pkt buffer = return packet from drive
		; Z if A=0

		; reset BC (chunk_progress) to 0 before return
		XRA			A					; A = 0
		MOV			B,A					; B = 0
		MOV			C,A					; C = 0
		POP			D					; restore DE
		POP			H					; restore HL
		; A = 0
		; BC = 0
		; DE = entry
		; HL = entry
		RET

; HL = last byte of file (not including eof) + 1
; TS=MkRamDirent,fattr,dirent_start
LOAD_End_DO:
		; append BA eof mark after new file -> write 0x1A @ HL
		MVI			M,0x1A				; [HL] = 0x1A
		RET								; pop & jump to MkRamDirent

; HL = last byte of file (not including eof) + 1
; TS=MkRamDirent,fattr,dirent_start
LOAD_End_BA:
		; append BA eof mark after new file -> write 0x00 0x00 @ HL
		XRA			A					; A = 0
		MOV			M,A					; [HL] = 0
		INX			H					; HL++
		MOV			M,A					; [HL] = 0
		LHLD		RamFileSize			; HL = [RamFileSize] = ram_fsize (fsize + 2 nuls)
		XCHG							; DE = ram_fsize
		; DOFILES must be updated after any change to any BA files
		; update DOFILES to point to the first byte after the new last BA file
		LHLD		DOFILES				; HL = [DOFILES] = old_dofiles_start
		DAD			D					; HL += DE  HL = new_dofiles_start
		SHLD		DOFILES				; [DOFILES] = new_dofiles_start
		RET								; pop & jump to MkRamDirent

; TS=MkRamDirent,fattr,dirent_start
LOAD_End_CO:
		; update COFILES to point to start of new ram file
		; CO files grow down from HIMEM
		LHLD		RamFileStart		; HL = [RamFileStart] = ram_fstart
		SHLD		COFILES				; [COFILES] = ram_fstart
		RET								; pop & jump to MkRamDirent

; TS=fattr,dirent_start
MkRamDirent:
		POP			PSW					; A = fattr  TS=dirent_start
		LHLD		RamFileStart		; HL = [RamFileStart] = ram_fstart
		XCHG							; DE = ram_fstart
		DCX			D					; DE--  DE = ram_fstart-1   (why?)
		POP			H					; HL = dirent_start
		JMP			MKDIRENT

; -----------------------------------------------------------------------------
; SAVE - copy a file from ram to disk
; -----------------------------------------------------------------------------
SAVE:
		; TS=MAIN
		CALL		DIRENT				; tell the drive our filename
		; A = B = data[0] from return packet = error/status, 0=success
		JNZ			errFF				; DIRENT returned file exists
		; B = 0  (we got past JNZ)
		LDA			FX1					; read 1st byte of filename ext
		CPI			'B'					; compare to 'B'
		JC			errSN				; reject if less than 'B'  (was NM)
		CPI			'E'					; compare to 'E'
		JNC			errSN				; reject if not less than 'E'  (was NM)
		CALL		FINDFN				; find the start of the file in ram
		; Z = not found, NZ = found
		; HL = sod  start of dirent
		; DE = sof  start of file
		; A = fattr
		; BC = unchanged
		JZ			errFF				; file not found in RAM

		; determine the file type and get the number of extra bytes to add to
		; fsize to get the full ram file length including added EOF bytes
		CALL		RamFileExtraLen		; A = extra_len
		; CO: A=0
		; DO: A=1
		; BA: A=2

		; Derive MKDIRENT ftype from extra_len. It's just a coincidence that
		; ftype BA=0 DO=1 CO=2 is a mirror image of extra_len BA=2 DO=1 CO=0
		; but I guess it saved a few bytes to take advantage of that coincidence
		MOV			C,A					; C = extra_len
		; CO: C=0
		; DO: C=1
		; BA: C=2
		MVI			A,ftypeCO			; A = highest = ftypeCO = 2
		SUB			C					; A -= extra_len (A = 2 - extra_len)
		; CO: A = 2-0 = 2
		; DO: A = 2-1 = 1
		; BA: A = 2-2 = 0
		; A = ftype
		; B = 0  (DIRENT -> A=B=data[0] -> got past JNZ)
		; C = extra_len
		PUSH		B					; stash BC=extra_len
		; TS=extra_len,MAIN
		PUSH		D					; stash DE=sof
		; TS=sof,extra_len,MAIN
		; DE = sof
		; HL = sod
		XCHG							; swap HL:DE
		; DE = sod
		; HL = sof
		; A = ftype
		CALL		AFTEREOF2			; HL = sonf (start of next file, aka eof+1)
		POP			D					; DE = sof
		; TS=extra_len,MAIN
		MOV			A,L					; A = sonf_lsb
		SUB			E					; A -= sof_lsb = ram_len_lsb
		MOV			L,A					; L = A = ram_len_lsb
		MOV			A,H					; A = sonf_msb
		SBB			D					; A -= sof_msb = ram_len_msb
		MOV			H,A					; H = A = ram_len_msb
		; HL = ram_len
		POP			B					; BC = extra_len
		; TS=MAIN
		; get true_len = ram_len - extra_len
		INR			C					; C++ = extra_len+1 (negate 1st iter)
		INX			H					; HL++ = ram_len+1  (negate 1st iter)
@decr_len:
		DCX			H					; HL-- = len--
		DCR			C					; C-- = extra_len--
		JNZ			@decr_len			; repeat until C=0
		; BC = 0
		; HL = true_len
		MOV			A,L					; A = true_len_lsb
		ORA			H					; true_len msb|lsb, iow set Z if true_len=0
		RZ								; if true_len=0 then there's nothing to do
		PUSH		D					; TS=sof,MAIN
		PUSH		H					; TS=true_len,sof,MAIN
		CALL		SendOpenCMD_write	; tell drive to open the file for write
		POP			D					; DE = true_len  TS=sof,MAIN
		POP			H					; HL = sof  TS=MAIN
		CALL		WriteChunks			; send WRITE packets
		MVI			A,cmd_close			; A = cmd_close

		; fall through to ShortPacket to send CLOSE packet

; Build & send a short packet (commands that have no data payload)
; A = cmd
ShortPacket:
		CALL		InitPacket
jSendPacket:
		CALL		SendPacket
		RZ								; no error
	IF ERRCODES
		; otherwise, decode the result byte
		; A = error code return data from drive, the first & only byte of pktDATA
ParseStdReturn:
		; shift right 3 bits to collapse 0x00-0x8F down to 0x00-0x10
		; drive err -> eXX (offset into STR_ErrCodes)
		; 0x00-0x0F -> 0x00
		; 0x10-0x1F -> 0x02
		; 0x20-0x2F -> 0x04
		; ...
		ANI			0xF0				; A &= 0xF0
		RAR								; Rotate A Right through carry
		RAR								; Rotate A Right through carry
		RAR								; Rotate A Right through carry
		MOV			E,A					; E = eXX offset into STR_ErrCodes
	ENDIF
		JMP			ERROR

; SAVE-related ----------------------------------------------------------------

SendOpenCMD_write:
		MVI			E,write_mode
SendOpenCMD:
		MVI			A,cmd_open
		CALL		InitPacket
		; InitPacket left HL=pktDLEN, A=cmd_open, & cmd_open HAPPENS to be 0x01
		MOV			M,A					; write 0x01 to pktDLEN - OPEN command has 1 byte of data
		INX			H					; advance HL to the first byte of pktDATA
		MOV			M,E					; write E to pktDATA - E = mode write/append/read
		JMP			jSendPacket			; send the packet

; HL = sof   start of file
; DE = len   length of file
WriteChunks:
		PUSH		H					; TS=position_a
		PUSH		H					; TS=position_a,position_a
		LXI			H,CHUNK_LEN			; HL = CHUNK_LEN
		_RST		rst_CompareDEHL		; compare DE(remaining_len) to HL(chunk_len)
		; flags: C if HL<DE, Z if HL=DE, else HL>DE, only A is destroyed
		; TS=position_a,position_a
		JNC			WriteFinalChunk		; exit loop when CHUNK_LEN >= remaining_len
		MOV			C,L					; C = L = CHUNK_LEN
		MOV			B,H					; B = H = 0, BC = CHUNK_LEN = 0x0080
		POP			H					; HL = position_a  TS=position_a
		DAD			B					; HL = HL+BC = position_a + CHUNK_LEN = position_b
		XTHL							; swap TS:HL -> TS=position_b  HL = position_a
		XCHG							; swap HL:DE -> DE = position_a, HL = remaining_len

		; subtract CHUNK_LEN from remaining_len by adding 0xFFFF-CHUNK_LEN+1
		LXI			B,0xFFFF-CHUNK_LEN+1	; BC = 0xFF80
		DAD			B					; HL += BC, iow HL -= CHUNK_LEN
		; HL = (new, smaller) remaining_len
		PUSH		H					; TS=remaining_len,position_b

		; HL = remaining_len
		; BC = 0xFF80 (B no longer matters, just that C = CHUNK_LEN)
		; DE = position_a
		CALL		SendWriteCMD

		; setup HL & DE for next chunk
		POP			D					; DE = remaining_len, TS[0] = position_b
		POP			H					; HL = position_b
		; HL = new higher start position, DE = new shorter length
		JMP			WriteChunks			; repeat
WriteFinalChunk:
		; TS=position_a,position_a
		MOV			C,E					; C = remaining_len
		POP			H					; HL = position_a  TS=position_a
		POP 		D					; DE = position_a
SendWriteCMD:
		MVI			A,cmd_write
		CALL		InitPacket 			; HL = pktDLEN
		MOV			M,C					; [pktDLEN] = C = chunk_len
		INX			H					; HL++ = pktDATA
		MOV			B,C					; B = C = chunk_len
		CALL		D2H4Bup				; copy B bytes from [DE] to [HL]
		JMP			jSendPacket			; send the packet, read it's return packet

; -----------------------------------------------------------------------------
; shared
; -----------------------------------------------------------------------------

InitPacket:
		; A = cmd
		LXI 		H,pktTYPE			; HL = pktTYPE
		MOV			M,A					; [pktTYPE] = A = cmd
		INX			H					; HL = pktDLEN
		MVI			M,0					; [pktDLEN] = 0
		; HL @ pktDLEN
		RET

; return A=0/1/2 depending on file type CO/DO/BA
; extra ram file length over true file length for added EOF bytes
; CO: A=0  (none, file is defined by CO header)
; DO: A=1  (eof = 0x1A)
; BA: A=2  (eof = 0x00 0x00)
RamFileExtraLen:
		LDA 		FX1					; A = FX1[0] 1st byte of filename extension
		; subtract 'C' because the possible values happen to be contiguous BCD,
		; and C is the center, so the result will be <0 for BA, 0 for C, >0 for DO
		SUI			'C'					; A -= 'C'
		; BA -> A = 0xFF flags SPC  (iow A = -1)
		; CO -> A = 0x00 flags ZP
		; DO -> A = 0x01 flags -
		; if file is CO or DO then A is ready now
		RP								; return if not S, file is not BA
		; file is BA, return A=2
		MVI			A,2		; A = 2
		; A=0x02 F=SPC
		RET								; file is BA

	IF DSR
CheckDSR:
		IN			FLOWCTL_PORT		; read RS232 flow control pins
		ANI			DSR_BITMASK			; check !DSR
		RZ								; Z = ready
		JMP			errND				; err no disk
	ENDIF ; DSR

; read 1 byte from rs232 to [HL], then HL++
RXtoM:
	IF DSR
		CALL		CheckDSR
	ENDIF
		CALL		RCV232				; A = rxbyte
		JC			errIO				; shift+break
		JNZ			errIO				; error
		MOV			M,A					; [HL] = A = rxbyte
		INX			H					; HL++
		; A = rxbyte
		; HL = entry+1
		RET

	IFNDEF PAUSE_DEx10us				; NEC has this in the system rom
PAUSE_DEx10us:							; 8-11us/iter * DE iters
		DCX 		D					; DE--
		MOV			A,D					; A = D
		ORA			E					; D|E -> Z if DE=0
		JNZ			PAUSE_DEx10us		; repeat until DE=0
		RET
	ENDIF

; -----------------------------------------------------------------------------
; strings & data
; -----------------------------------------------------------------------------

; Used in LOAD for the differences in how each file type is inserted in ram.
TBL_ftypes:
		DB			fattrCO				; +0*5 for CO files
		DW			LOAD_End_CO
		DW			COFILES

		DB			fattrDO				; +1*5 for DO files
		DW			LOAD_End_DO
		DW			DOFILES

		DB			fattrBA				; +2*5 for BA files
		DW			LOAD_End_BA
		DW			BAFILES

STR_STAT:
		COM_STAT

STR_Prompt:
		DB			"> C FFFFFF.XX (C=KLSQ)",CR,LF,"> ",0

STR_Err:
	IF ERRCODES
		DB			" Err",CR,LF,0,"FFUESNIOWPDFNDHW"
	ELSE
		DB			"ER",CR,LF,0
	ENDIF

	IF ERRCODES
STR_ErrCodes		EQU STR_Err+5

; Offsets into STR_ErrCodes. Drive returns 0x00-0x8F -> ParseStdReturn -> eXX
; see ParseStdReturn & dl2/constants.h
eFF					EQU		0x02		; directory - file not found, file already exist
eUE					EQU		0x04		; unknown - 0x20-0x2F, never observed
eSN					EQU		0x06		; syntax
eIO					EQU		0x08		; integrity - crc & other data sanity failures, disk/serial/ram
eWP					EQU		0x0A		; write-protect, format
eDF					EQU		0x0C		; bounds - dir/file/disk full/exceeded
eND					EQU		0x0E		; presense - disk changed / not inserted
eHW					EQU		0x10		; hardware - physical drive or disk problems
	ENDIF

PRGEND:
