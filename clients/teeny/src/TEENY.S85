; TINY/TEENY disassembly
; TINY by Ed Giese (Acroatix). TEENY is TINY that Ron Weisen made a bit smaller.
; Originally based on a disassembly of TEENY for Model 100.
; This version no longer aims to reproduce the legacy binary.
; Platform & rom references: https://github.com/bkw777/m100_dev
; Brian K. White
;
; build with:
;	z88dk-z80asm -m8085_strict -no-synth -DMODEL_100 -b -o=TEENY.CO TEENY.S85 && \
;	z88dk-z80asm -m8085_strict -no-synth -DMODEL_100 -DPRGLEN=$(wc -c <TEENY.CO) -b -o=TEENY.CO TEENY.S85
;
; Builds for 100, K85, M10 na & eu, 200, NEC
; $ make 100
; or
; build & verify that the 100 or M10 build reproduces the original exactly
; $ make verify_100
; $ make verify_M10

;;;;
;;;; 100 works
;;;; M10na works
;;;; M10eu works
;;;; K85 works
;;;; 200 does not work, but ../orig/disasm/TNY200.S85 does
;;;; NEC does not work, but ../orig/disasm/TNYNEC.S85 does
;;;;

; -----------------------------------------------------------------------------
; CONFIGURATION
; -----------------------------------------------------------------------------

; TPDD1 default is 19200 but dip switch settable 150-76k.
; TPDD2 is 19200 only. (not even solder-jumper option)
; Brother FB-100, KnitKing FDD19, and Purple Computing D103 are 9600 only.
; (actually settable 150-76k like TPDD1, but only via solder jumpers)
; System rom max is 19200.
	IFNDEF BAUD
BAUD 				EQU		19200
	ENDIF

; The DSR check makes it so we gracefully detect when the drive is not
; connected or not ready. But since it's not neccessary, and the point of
; TEENY is to be teeny, the DSR code is not included by default in this version.
; It is included in most old teeny binaries, though it was a user choice at
; install-time in TEENY.EXE . If we really cared about robustness and data
; integrity, we wouldn't be ignoring the checksums on the return packets!
	;DEFINE INCLUDE_DSR

	IFNDEF CHUNK_LEN
CHUNK_LEN			EQU		128		; 1-128
	ENDIF

COM_SETUP_PAUSE_MS	EQU		100

	IF INCLUDE_ERRS
	DEFINE ERRS
	ELSE
	UNDEFINE ERRS
	ENDIF

; -----------------------------------------------------------------------------
; ASSEMBLER
; -----------------------------------------------------------------------------

; z88dk before db5c165 (20260602) doesn't recognize the intel syntax for RST
_RST MACRO n
	IF Z88DK && Z88DK<25000
		RST n*8
	ELSE
		RST n
	ENDIF
	ENDM

; -----------------------------------------------------------------------------
; TARGET PLATFORM
; -----------------------------------------------------------------------------

	IF MODEL_200na
	INCLUDE		"200na.S85"
	ELIF MODEL_NECna
	INCLUDE		"NECna.S85"
	ELIF MODEL_K85na
	INCLUDE		"K85na.S85"
	ELIF MODEL_M10na
	INCLUDE		"M10na.S85"
	ELIF MODEL_M10eu
	INCLUDE		"M10eu.S85"
	ELSE
	INCLUDE		"100na.S85"
	ENDIF

	IFNDEF FLOWCTL_PORT
FLOWCTL_PORT		EQU		0xBB				; COM & LPT flow control bits
	ENDIF
	IFNDEF DSR_BITMASK
DSR_BITMASK			EQU		0x20
	ENDIF

; COM "STAT" string, not including the speed (speed is configurable)
; TPDD protocol is raw binary data, so must be 8 bit and no xon/xoff
	IFNDEF COM_PARAMS
COM_PARAMS MACRO
	DB "8N1D"
	ENDM
	ENDIF

; complete COM STAT string ex: "98N1D"
COM_STAT MACRO
	IF BAUD = 19200
	COM_SPEED EQU '9'
	ELIF BAUD = 9600
	COM_SPEED EQU '8'
	ELIF BAUD = 4800
	COM_SPEED EQU '7'
	ELIF BAUD = 2400
	COM_SPEED EQU '6'
	ELIF BAUD = 1200
	COM_SPEED EQU '5'
	ELIF BAUD = 600
	COM_SPEED EQU '4'
	ELIF BAUD = 300
	COM_SPEED EQU '3'
	ELIF BAUD = 110
	COM_SPEED EQU '2'
	ELIF BAUD = 75
	COM_SPEED EQU '1'
	ELSE
	COM_SPEED EQU '8'	; only some drives can do 19200 but all can do 9600
	ENDIF

	DB COM_SPEED
	COM_PARAMS
	ENDM

; cpu opcodes
opcode_LXI_B		EQU		0x01

; ascii
ETX					EQU		0x03
LF					EQU		0x0A
FF					EQU		0x0C
CR					EQU		0x0D
ESC 				EQU		0x1B
SPACE				EQU		0x20

; MKDIRENT file type attributes
fattrBA				EQU		0x80		; .BA files
fattrDO				EQU		0xC0		; .DO files
fattrCO				EQU		0xA0		; .CO files
; file types, reg A for AFTEREOF2
ftypeBA				EQU		0x00
ftypeDO				EQU		0x01
ftypeCO				EQU		0x02
; number of extra bytes in a RAM file vs the true file size
eofbytesBA			EQU		2
eofbytesDO			EQU		1
eofbytesCO			EQU		0

rst_NextNonSpace	EQU		2			; RST 2 = get next non-whitespace char from M to A
rst_CompareDEHL		EQU		3			; RST 3 = compare DE and HL
rst_Print_A			EQU		4			; RST 4 = print A to LCD/LPT

local_fname_len		EQU		9			; XXXXXX.XX
FX1					EQU		FILNM1+6	; EXT of FILNM1 after CKFN2 (“CO”, “DO”, “BA”)

; -----------------------------------------------------------------------------
; TPDD
; -----------------------------------------------------------------------------

ZZ					EQU		0x5A5A				; packet start / preamble, "ZZ"

; commands
cmd_dirent			EQU		0x00
cmd_open			EQU		0x01
cmd_close			EQU		0x02
cmd_read			EQU		0x03
cmd_write			EQU		0x04
cmd_delete			EQU		0x05
cmd_status			EQU		0x07

; returns
ret_read			EQU		0x10
ret_dirent			EQU		0x11
ret_std				EQU		0x12

; dirent actions
dirent_set_name		EQU		0x00

; file open modes
write_mode			EQU		0x01
append_mode			EQU		0x02
read_mode			EQU		0x03

tpdd_fname_len		EQU		24
cmd_dirent_dlen		EQU		tpdd_fname_len + 1 + 1	; 24(fname) + 1(attr) +1(action)
pkt_len_overhead	EQU		5	; 2(ZZ) + 1(fmt) + 1(len) [DATA] + 1(chk)

; -----------------------------------------------------------------------------
; APPLICATION
; -----------------------------------------------------------------------------

; TINY uses ALTCD for it's variables and packet buffer
; start of ALTLCD (100)							; FCC0

RamFileStart		EQU		ALTLCD + 0x40		; FD00
RamFileSize			EQU		ALTLCD + 0x42		; FD02
DskFileSize			EQU		ALTLCD + 0x44		; FD04  native lsb-first copy of tpdd msb-first filesize
InitialSP			EQU		ALTLCD + 0x46		; FD06  initial stack pointer
LoadingFlag			EQU		ALTLCD + 0x48		; FD08
; TPDD packet
pktZZ				EQU		ALTLCD + 0x4A		; FD0A  tpdd packet preamble "ZZ"
pktTYPE				EQU		ALTLCD + 0x4C		; FD0C  tpdd packet type, cmd_xxx or ret_xxx
pktDLEN				EQU		ALTLCD + 0x4D		; FD0D  tpdd packet data length, 0-128
pktDATA				EQU		ALTLCD + 0x4E		; FD0E  tpdd packet data, 0-128 bytes, +1 checksum byte

; filesize field within a DIRENT return packet
; pktDATA +  0 : fname
; pktDATA + 24 : attr
; pktDATA + 25 : fsize msb
; pktDATA + 26 : fsize lsb
direntFSIZE			EQU		pktDATA + tpdd_fname_len + 1	; FD27

;              start of data + data len + checksum byte
; end of packet buffer		pktDATA + CHUNK_LEN + 1         ; FD8F

; end of ALTLCD				ALTLCD + 0x013F		; FDFF

; -----------------------------------------------------------------------------
; ORG
; -----------------------------------------------------------------------------

; ORG & CO Header works backwards from HIMEM-PRGLEN.
; PRGLEN has to be supplied from outside via -DPRGLEN=len.
; If no PRGLEN then build with default ORG 0 and no CO header.
	IFDEF PRGLEN
	;--------------------------------------------------------------------------
	; ORG
	;--------------------------------------------------------------------------
	IFNDEF HIMEM
HIMEM				EQU		MAXRAM
	ENDIF

	ORG HIMEM-PRGLEN-6			; entry minus length of header

	;--------------------------------------------------------------------------
	; .CO HEADER
	;--------------------------------------------------------------------------
	DW PRGTOP
	DW PRGLEN
	DW PRGEXE
	ENDIF ; PRGLEN
;------------------------------------------------------------------------------


; -----------------------------------------------------------------------------
; START
; -----------------------------------------------------------------------------

;------------------------------------------------------------------------------
PRGTOP:
PRGEXE:
		LXI			H,0				; HL = 0
		DAD			SP				; HL = stack pointer
		SHLD		InitialSP		; InitialSP = stack pointer
		LXI			H,ZZ			; HL = "ZZ" = tpdd packet preamble
		SHLD		pktZZ			; pktZZ = "ZZ" preamble field of packet buffer never changes
MAIN:
		; reset stack pointer every time we return to main since we have many aborts after random pushes
		LHLD		InitialSP		; HL = InitialSP
		SPHL						; SP = InitialSP
		XRA			A				; A = 0
		STA			LoadingFlag		; LoadingFlag = 0
		LXI			H,MAIN			; load MAIN addr to HL
		PUSH		H				; push HL
		LXI			H,STR_Prompt	; load addr to prompt string to HL
		CALL		PTILL0			; print HL
		; we just printed the prompt
		; now collect the user input
		STA			KYBCNT			; write 0 to keyboard pending keystrokes count
		CALL		INLIN			; get a line of input from keyboard
		; The keyboard buffer now has a command line like |L MYPROG.BA|
		LXI			H,errSN			; load the address of errSN to HL  (was NM)
		SHLD		ETRAP			; set errSN as ON ERROR handler
		LXI			H,KYBUF+1		; load addr to 2nd byte of keyboard buffer to HL
		MVI			M,'"'			; write " to 2nd byte of keyboard buffer
		; before |L MYPROG.BA|
		; after  |L"MYPROG.BA|
		; HL still points to the "
		; The next call reads it the same way BASIC reads ex: |SAVE"MYPROG.BA|
		; that's why no matching closing " needed
		CALL		CKFN2			; evaluate & reformat filename
		CALL		RESETFPS		; reset file pointers
		LDA			KYBUF			; read 1st byte of keyboard buffer
		CPI			'Q'				; is it 'Q' ?
		JZ			MENU			; then exit to OS (main menu)
		CPI			'S'				; is it 'S' ?
		JZ			SAVE			; then jump to SAVE
		PUSH 		PSW				; stash A=cmd
		; if we got here then the command is K, L, or unknown
		; KILL or LOAD both start with telling the drive the filename
		CALL		DIRENT          ; set disk filename and ask drive if file exists on disk
		JZ			errFF			; Z = file not found on disk, abort with FF error
		; file found on disk
		POP 		PSW				; restore A=cmd
		SUI			'K'				; A -= 'K'
		JZ			KILL			; if A == 0 then cmd is 'K', jump to KILL
		DCR 		A				; A--
		JZ			LOAD			; if A == 0 then cmd is 'L', jump to LOAD

		; if we got here, cmd is unknown

; ERROR CODES - this stack of jump targets uses an opcode-as-data trick
; 1: The first MVI_E,eXX you hit executes normally and sets E=eXX.
; 2: The DB opcode_LXI_B after that executes as code and consumes the next
;    2 bytes as it's operand, which is the next MVI_E and it's eXX operand.
; 3: The next byte after that is another LXI_B, repeat 2: until end of stack.
; 4: Fall through into ERROR with E=eXX.

	IF ERRS
errSN:
		MVI			E,eSN			; fell from above = unknown cmd = syntax error
		DB			opcode_LXI_B
errFF:
		MVI			E,eFF
		DB			opcode_LXI_B
errUE:
		MVI			E,eUE
		DB			opcode_LXI_B
errIO:
		MVI			E,eIO
		DB			opcode_LXI_B
errWP:
		MVI			E,eWP
		DB			opcode_LXI_B
errDF:
		MVI			E,eDF
		DB			opcode_LXI_B
errND:
		MVI			E,eND
		DB			opcode_LXI_B
errHW:
		MVI			E,eHW

;		E = eXX  some error code
;		B = junk
	ELSE
	; if not including error codes, then define all the jump targets to be the
	; same as ERROR, so we don't have to have as many ifdefs everywhere else
errSN:
errFF:
errUE:
errIO:
errWP:
errDF:
errND:
errHW:
	ENDIF

ERROR:
		; if we were in the middle of SAVE, then undo the partial new file
		LDA 		LoadingFlag		; A = LoadingFlag
		ORA 		A				; does LoadingFlag == 0?
		JZ 			@show			; if 0 skip to @show
	IF ERRS
		PUSH 		D				; save E=eXX
	ENDIF
		LHLD 		RamFileSize		; HL=RamFileSize
		MOV 		B,H				; B=H
		MOV 		C,L				; C=L  BC=RamFileSize
		LHLD 		RamFileStart	; HL=RamFileStart
		CALL		MASDEL			; delete BC bytes @ HL
	IF ERRS
		POP 		D				; restore E=eXX
	ENDIF
@show:
	IF ERRS
		LXI			H,STR_ErrCodes	; HL = start of string of err codes
		MVI			D,0				; D=0 E=eXX from above
		DAD			D				; HL=STR_Errcodes+eXX
		MOV			A,M				; get first byte of error code
		_RST		rst_Print_A			; print it
		_RST		rst_NextNonSpace	; get next byte of err code
		_RST		rst_Print_A			; print it
	ENDIF
		LXI			H,STR_Err		; get STR_Err
		CALL		PTILL0			; print it
		JMP			MAIN			; restart at main

	IFNDEF PAUSE_DEx10us			; NEC has this in the system rom
PAUSE_DEx10us:						; 8-11us/iter * DE iters
		DCX 		D				; DE--
		MOV			A,D				; A = D
		ORA			E				; D V E sets Z only when both D and E == 0
		JNZ			PAUSE_DEx10us	; repeat until DE=0
		RET
	ENDIF

STR_STAT:
		COM_STAT

InitPacket:
		LXI 		H,pktTYPE		; HL @ pktTYPE
		MOV			M,A				; pktTYPE = A = cmd_xxxxx from caller
		INX			H				; HL @ pktDLEN
		MVI			M,0				; pktDLEN = 0
		; HL @ pktDLEN
		RET

	IF INCLUDE_DSR
CheckDSR:
		IN			FLOWCTL_PORT	; read RS232 flow control pins
		ANI			DSR_BITMASK		; check !DSR
		RZ
	IF ERRS
		MVI			E,eND			; set ND error  (was NR)
	ENDIF ; /ERRS
		JMP			ERROR
	ENDIF ; /INCLUDE_DSR

DIRENT:
		; activate rs232
		CALL		COMOFF				; disable MDM/COM
		; original TEENY uses 0x2E -> about 100ms. make it so MS=100 produces 0x2E
		MVI        D,COM_SETUP_PAUSE_MS*100/215		; 0x2E00 timing loops
		CALL       PAUSE_DEx10us		; burn cpu for DE*10us = about 100ms
		LXI			H,STR_STAT			; load a STAT string ("98N1D")
		STC								; set carry flag - tells SET232 to apply to the RS232 port
		CALL		SET232				; configure uart per the stat string

		; send a STATUS packet
		MVI			A,cmd_status		; A = cmd_status
		CALL		ShortPacket			; send STATUS packet

		; send a DIRENT packet
		; 2     1   1   24           1     1       1
		; 5A5A  00  1A  filename     attr  action  chk

		; start building a DIRENT(set_name) cmd packet
		XRA			A					; A = 0
		CALL		InitPacket			; write 0x00 (cmd_dirent) to pktTYPE (cmd)
		; HL @ pktDLEN (len)
		MVI			M,cmd_dirent_dlen	; pktDLEN = 26
		INX			H					; HL = pktDATA (start of data)
		; HL @ pktDATA (data)
		LXI			D,KYBUF+2			; DE = 3rd byte into keyboard buffer (skip over "C ")
		MVI			B,local_fname_len	; B = 9
		CALL		D2H4Bup				; append 9 bytes (filename FFFFFF.XX) from DE (keyb buf) to HL (packet data)
		; HL @ pktDATA+9
		MVI			B,tpdd_fname_len-local_fname_len	; B = 15, 24 byte tpdd filename field minus 9 bytes XXXXXX.XX
@l0:
		MVI			M,SPACE				; append " " to packet data
		INX			H					; next byte
		DCR			B					; B--
		JNZ 		@l0					; repeat 14 more times (write 15 spaces) + 9 bytes filename = 24 bytes tpdd filename field
		; HL @ pktDATA+24
		MVI 		M,'F'				; hard-coded always write 'F' in attr field
		INX			H					; next byte
		; HL @ pktDATA+25 aka the dirent action field, and B happens to be 0,
		; which also happens to be the dirent action code for dirent(set_name)
		MOV			M,B					; M@pktDATA+25 = action = B = 0 = set_name
		; dirent(set_name) tells the drive the filename for an open/close/read/write/kill to follow

; DIRENT -> SendPacketSpecial -> SendPacket fall-throughs:
; 1 - DIRENT falls into SendPacketSpecial
; 2 - if not ERRS, then SendPacketSpecial is replaced by SendPacket
; So if not ERRS, SendPacketSpecial label still exists but just a label that
; does nothing but fall into SendPacket, so the CALL from READ and the fall
; from DIRENT both still work without a needless JMP.

; send a DIRENT or READ packet and detect which kind of return packet we got
SendPacketSpecial:
	IF ERRS
		CALL		SendPacket
		MOV			B,A					; B = data[0] from SendPacket
		LDA			pktTYPE				; A = return packet type
		CPI			ret_std				; is it a standard return packet?
		JZ			ParseStdReturn		; if it's a standard return then jump to the standard return parser
		; it's not a standard return (it's a DIRENT or READ return)
		; restore the A & Z state left by SendPacket
		MOV			A,B					; A = data[0]
		ORA			A					; if A = 0 set Z
		; places RET might go:
		; * CALL SendPacketSpecial in SendReadCMD
		; * CALL DIRENT in MAIN
		RET
	ENDIF

	; MUST be followed by SendPacket to handle if not ERRS

; * Calculate & append checksum to packet
; * Send the REQuest packet
; * Receive the RETurn packet
SendPacket:

; -----------------------------------------------------------------------------
; FINISH BUILDING OUTGOING PACKET (calculate and append checksum)
; -----------------------------------------------------------------------------

		; Calculate Packet Checksum
		; Sum all the bytes in the specified range.
		; Take the least significant byte of that sum.
		; Invert all the bits in that byte.
		; The checksummed range is the start of cmd through end of data.

		; add cmd and len to ckecksum
		LXI			H,pktTYPE		; HL @ pktTYPE
		MOV			A,M				; A = cmd
		INX			H				; HL @ pktDLEN 
		ADD			M				; A = A + len
		MOV			D,A				; D = A
		MOV			A,M				; A = len
		MOV			E,A				; E = len
		MOV			B,A				; B = len
		INX			H				; HL @ pktDATA
		ORA			A				; set Z if len==0
		MOV			A,D				; A = sum from D
		JZ			@endpkt			; if len==0 then jump to finish checksum
		; len>0, add sum len bytes from pktDATA

		; add data to checksum
@l0:
		ADD			M				; add data byte to sum (sum rolls over every 0xFF) 
		INX			H				; next data byte
		DCR			E				; E--
		JNZ			@l0				; repeat for E (len) bytes
		; HL @ pktDATA+len

		; append checksum to packet
@endpkt:
		; A = sum
		CMA							; complement A, A = tpdd checksum now
		; A = CheckSum
		MOV			M,A				; append checksum to packet

; -----------------------------------------------------------------------------
; SEND OUTGOING PACKET
; -----------------------------------------------------------------------------

		; Set B counter to len+5 for the full packet length
		; B =  2   + 1    + 1    + len     + 1
		;      ZZ    TYPE   DLEN   DATA      CHK

		MVI			A,pkt_len_overhead	; A = 5
		ADD			B				; A += B -> A = 5+len
		MOV			B,A				; B = 5+len
		; B = loop counter for all bytes in packet, ZZ to CKSUM inclusive
		; start HL at pktZZ
		LXI			H,pktZZ			; HL @ pktZZ (0x5A5A aka "ZZ")

@send_byte:
		MOV			A,M				; A = byte from packet
		CALL		SND232			; send byte out rs232
		JC			errIO			; if shift+break then jump to errIO
	IF INCLUDE_DSR
		CALL		CheckDSR
	ENDIF
		INX			H				; advance HL to next byte in packet
		DCR			B				; B--
		JNZ			@send_byte		; send bytes until B=0

; -----------------------------------------------------------------------------
; RECIEVE RETURN PACKET
; -----------------------------------------------------------------------------

		; tpdd return packet starts with pktTYPE, no ZZ
		LXI			H,pktTYPE		; HL @ pkTYPE
		CALL		INT1D			; disable interrupts
		CALL		ReadSerialByteIncHL	; read byte from serial to pktTYPE, HL @ pktDLEN
		CALL		ReadSerialByteIncHL	; read byte from serial to pktDLEN, HL @ pktDATA
		MOV			C,A				; C = return packet DLEN
		INR			C				; C = DLEN + 1 (data length & 1 byte checksum)
		; read C more bytes from serial
@read_byte:
		CALL		ReadSerialByteIncHL	; read a byte from serial to pktDATA
		DCR			C				; C--
		JNZ			@read_byte		; repeat until C = 0
		; pktDATA now contains the return DATA and the checksum byte
		; we never use the checksum but we must consume the entire packet
		XRA			A				; A = 0
		SIM							; IM = 0 -> enable all interrupts
		LXI			H,pktDLEN		; HL @ pktDLEN
		MOV			C,M				; C = DLEN
		INX			H				; HL++ -> HL@pktDLEN+1 -> HL@pktDATA
		MOV			A,M				; read 1st byte @ pktDATA
		ORA			A				; set Z if first byte of data is 0

		; return packet types:
		; LOAD    0x10 read file data return, dlen 0 to 128, A could be data[0] or checksum
		; DIRENT  0x11 dirent return, dlen 28, A is filename[0]
		; others  0x12 standard return, dlen 1, A is error code, 0x00 = success
		; So for most packets we are returning A=err and setting Z if err=0
		; A & Z don't seem to be meaningful for LOAD or DIRENT
		; A = error code from drive (except LOAD or DIRENT)
		; Z = set if A=0
		; C = return packet data length
		; HL @ pktDATA (or @checksum if read-file-data len=0)
		RET

; read 1 byte from rs232 to M, advance HL
ReadSerialByteIncHL:
	IF INCLUDE_DSR
		CALL		CheckDSR
	ENDIF
		CALL		RCV232
		;JC			errIO
		;JNZ			errCM
		JNZ			errIO
		MOV			M,A
		INX			H
		RET

KILL:
		MVI			A,cmd_delete
		JMP			ShortPacket

SendOpenCMD_write:
		MVI			E,write_mode
SendOpenCMD:
		MVI			A,cmd_open
		CALL		InitPacket
		; HL @ pktDLEN
		; InitPacket left HL sitting on pktDLEN and didn't change A.
		; Why would we write the cmd_open pktTYPE code there?
		; Because it HAPPENS to be 1, and we HAPPEN to want to write a length of 1.
		MOV			M,A					; write 0x01 to pktDLEN - OPEN command has 1 byte of data
		INX			H					; advance HL to the first byte of pktDATA
		MOV			M,E					; write E to pktDATA - E = mode write/append/read
		JMP			jSendPacket			; send the packet

SendFinalWriteChunk:
		POP 		D
SendWriteCMD:
		MVI			A,cmd_write
		CALL		InitPacket 			; HL@pktDLEN, M=0
		MOV			M,C					; write C=chunk_len to pktDLEN
		INX			H					; advance HL to pktDATA
		MOV			B,C					; tell D2H4Bup how many bytes to copy
		CALL		D2H4Bup				; copy B bytes from DE to HL
		JMP			jSendPacket			; send the packet, read it's return packet

LOAD:
; FINDFN reads FILNM1 (FC93 on 100) which has been set up by CKFN2 in MAIN
		CALL		FINDFN				; see if the proposed file already exists in ram
		JNZ			errFF				; abort with FF error if the file already exists (was AE)
		LXI			H,errDF				; HL=errDF
		SHLD 		ETRAP				; set errDF as the general error handler (was FL)
		CALL		SCNEMP				; find empty ram file direrctory entry
		PUSH		H
		CALL		GetFtypeX			; determine the filetype, CO, DO, or BA
		; BA: A=2 F=SPC
		; CO: A=0 F=ZP
		; DO: A=1
		LHLD		direntFSIZE			; HL = msb-first filesize from DIRENT return.
		; direntFSIZE was written by DIRENT: while still in MAIN: before coming here.
		; All 16-bit values in tpdd packets are msb-first. H=lsb L=msb
		MOV			B,L					; copy msb to B
		MOV			C,H					; copy lsb to C
		; BC = normal lsb-first filesize
		MOV			L,C					; copy lsb to L
		MOV			H,B					; copy msb to H
		; HL = normal lsb-first filesize
		SHLD		DskFileSize			; write filesize to DskFileSize
		DCX			B					; BC-- (filesize minus 1)
		MOV			E,A					; E = ftype (CO=0 DO=1 BA=2)
		INR			A					; A = ftype+1 (CO=1 DO=2 BA=3)
@l0:	; add 0/1/2 eof marker bytes to true filesize to get ram filesize
		INX			B					; BC++
		DCR			A					; A--
		JNZ			@l0					; repeat until A=0
		; CO: BC=filesize+0  CO files end is defined in the CO header, no added eof marker bytes
		; DO: BC=filesize+1  DO files end with 1 added EOF byte (0x1A)
		; BA: BC=filesize+2  BA files end with 2 added NUL bytes
		;
		; A = 0
		; BC = ram filesize (true filesize + 0, 1, or 2)
		;
		; FtypeTable is a table with 3 blocks, one each for CO, DO, & BA filetypes
		; Each block is 5 bytes in 3 fields:
		; 1 byte:  attribute for MKDIRENT   fattrCO fattrDO fattrBA
		; 2 bytes: jump address             jCOFILE jDOFILE jBAFILE
		; 2 bytes: start of filetype area   COFILES DOFILES BAFILES
		MOV			D,A					; D=0 E=0/1/2 DE=0/1/2
		; get the address of the start of FtypeTable
		LXI			H,FtypeTable		; HL = FtypeTable
		; move to the correct block for the file type
		DAD			D					; HL += DE
		DAD			D					; HL += DE
		DAD			D					; HL += DE
		DAD			D					; HL += DE
		DAD			D					; HL += DE
		; CO: DE=0 -> HL = FtypeTable + 0
		; DO: DE=1 -> HL = FtypeTable + 5
		; BA: DE=2 -> HL = FtypeTable + 10
		MOV			A,M					; A = byte @ HL
		; CO: A = fattrCO
		; DO: A = fattrDO
		; BA: A = fattrBA
		PUSH		PSW					; push fattrXX

		; attr fattrCO / fattrDO / fattrBA has been read from the jump table and pushed

		LXI			D,MkRamDirent		; DE = MkRamDirent
		PUSH		D					; push MkRamDirent

		; MkRamDirent is on the stack
		; There is no matching pop, it gets used by RET
		; at the end of jCOFILE/jDOFILE/jBAFILE

		INX			H					; HL++ to jump addr lsb
		MOV			E,M					; E = jump addr lsb
		INX			H					; HL++ to jump addr msb 
		MOV			D,M					; D = jump addr msb
		PUSH		D					; push jump addr

		; jCOFILE/jDOFILE/jBAFILE is on the stack
		; There is no matching pop, it gets used by RZ
		; exiting the loop at the end of LOAD

		INX			H					; HL++ to XXFILES area pointer
		MOV			E,M					; E = XXFILES pointer lsb
		INX			H					; HL++ to XXFILES pointer msb
		MOV			H,M					; H = XXFILES pointer msb
		MOV			L,E					; L = XXFILES pointer lsb   HL=XXFILES pointer

		; HL = COFILES/DOFILES/BAFILES

		; read the file area start addr from the pointer addr
		MOV			E,M					; E = XXFILES lsb
		INX			H					; HL++
		MOV			D,M					; D = XXFILES msb

		; DE = start of COFILES, DOFILES, or BAFILES area

		MOV			H,B					; H = ram filesize msb
		MOV			L,C					; L = ram filesize lsb
		; HL = ram filesize
		SHLD		RamFileSize			; RamFileSize = ram filesize
		XCHG							; swap HL:DE
		; DE = ram filesize
		; HL = start of CO/DO/BA FILES area
		SHLD		RamFileStart		; RamFileStart = HL (new ram file starts at the beginning of the area for it's type)
		PUSH		H					; stash HL=RamFileStart
		; jaddr@ts-1
		CALL		MAKHOL				; create space for new file
		JC			errDF				; abort with DF err if MAKHOL failed from not enough memory (was OM)
		; set a status flag that we are now loading from disk to ram
		LXI			H,LoadingFlag		; HL = LoadingFlag
		INR			M					; LoadingFlag++
		CALL		SendOpenCMD_read	; open the tpdd file for reading
		LHLD		DskFileSize			; HL = DskFileSize
		XCHG							; swap HL:DE  DE = DskFileSize
		POP			H					; HL = RamFileStart
		; jaddr@ts

		LDA			pktTYPE				; A = packet type  (should be 0x10 for read return?)
		MOV			C,A					; C = packet type
		MVI			B,0					; B = 0, BC = packet type
		; BC = packet type
		; DE = tpdd file size lsb-first D=lsb E=msb
		; HL = ram file start
		; TS[0] = jCOFILE/jDOFILE/jBAFILE
		; TS[1] = MkRamDirent
		; TS[2] = fattrXX
@l1:
		MOV			A,D					; A = D = filesize lsb
		ORA			E					; A = DVE (lsbVmsb), iow set Z if DE==0
		MOV			A,C					; A = C = packet type
		STA			pktTYPE				; pktTYPE = packet type

		; We did not get here via CALL: ORG->MAIN->JZ LOAD->here
		; So RZ will "return" to whatever is in TS[0] -> jXXFILE
		RZ								; when DE=0 jump to jXXFILE

		ORA			A					; is packet type 0?
		CM			SendReadCMD			; call if packet type <0 ???
		DCX			D					; DE--
		PUSH		H					; stash HL = current byte position in ram file
		; jXXFILE@TS[1]
		LXI			H,pktDATA			; HL = start of packet data
		DAD			B					; HL += BC, BC = packet type ???????
		MOV			A,M					; A = byte @ HL
		POP			H					; retore HL = byte position in file
		; jXXFILE@TS[0]
		MOV			M,A					; write byte from packet to ram
		INX			H					; HL++ (advance to next byte of file)
		; entire packet len always <256, byte is enough
		INR			C					; C++ (advance to next byte of packet)
		JMP			@l1					; repeat

SendOpenCMD_read:
		MVI			E,read_mode
		CALL		SendOpenCMD
SendReadCMD:
		PUSH		H					; stash HL
		PUSH		D					; stash DE
; start READ cmd packet
		MVI			A,cmd_read			; A = READ packet fmt code
		CALL		InitPacket			; Construct a tpdd packet
		CALL		SendPacketSpecial	; send the packet to the drive, read the return packet from the drive, handle std vs special return
		; A = data[0], Z = set if A=0 (no error)
		XRA			A					; A = 0
		MOV			B,A					; B = 0
		MOV			C,A					; C = 0
		STA			pktTYPE				; A = pktTYPE (return packet fmt)
		POP			D					; restore DE
		POP			H					; restore HL
		RET

; Used in LOAD. The different file types need different operations when
; inserting a new file in ram.
FtypeTable:
	DB fattrCO				; +0
	DW jCOFILE
	DW COFILES
	DB fattrDO				; +5
	DW jDOFILE
	DW DOFILES
	DB fattrBA				; +10
	DW jBAFILE
	DW BAFILES

; In LOAD: we pushed fattrXX, then MkRamDirent, then jXXFILE.
; Then at the end of the copy-to-ram loop we RZ while we are not in a CALL,
; so RZ takes the jXXFILE addr off the top of the stack and "returns" there.
; Then each of these jXXFILE: ends in a RET, and we are still not in a CALL,
; so the RET at the end of jCOFILE/jDOFILE/jBAFILE goes to MkRamDirent.
; Top of stack has fattrXX on entering MkRamDirent

jDOFILE:
		MVI			M,0x1A
		RET								; really a jump to MkRamDirent

jBAFILE:
		; We jumped here by the RZ at the end of the copy-to-ram loop,
		; HL currently points at the byte after the end of the file.
		; BA files need 2 NUL added after the contents, write 2 nulls here.
		XRA			A					; A=0
		MOV			M,A					; write 0 @ HL
		INX			H					; HL++
		MOV			M,A					; write 0 @ HL
		LHLD		RamFileSize			; HL = RamFileSize
		XCHG							; DE = RamFileSize
		; DOFILES area starts immediately after BAFILES area ends.
		; Update the DOFILES pointer to point to the first byte
		; after the file we just wrote.
		LHLD		DOFILES				; HL = DOFILES
		DAD			D					; add RamFileSize to DOFILES
		SHLD		DOFILES				; write updated DOFILES
		RET								; really a jump to MkRamDirent

jCOFILE:
		LHLD		RamFileStart
		SHLD		COFILES
		RET								; really a jump to MkRamDirent

MkRamDirent:
		POP			PSW					; A = fattrXX
		LHLD		RamFileStart		; HL = RamFileStart
		XCHG							; DE = RamFileStart
		DCX			D					; DE--
		POP			H					; HL = whatever DE was, DOFILES/COFILES/BAFILES?
		JMP			MKDIRENT

; read 1st byte of fname ext, return:
; BA -> A=2 F=SPC
; CO -> A=0 F=ZP
; DO -> A=1
GetFtypeX:
		LDA 		FX1					; read 1st byte of filename extension
		SUI			'C'					; subtract 'C'
		; BA: A=FF F=SPC
		; CO: A=00 F=ZP
		; DO: A=01 F=
		RP								; return if not S, file is not BA
		MVI			A,eofbytesBA		; A = eofbytesBA = 2
		; BA: A=2 F=SPC
		RET								; file is BA

; copy a file from local ram to tpdd
SAVE:
		CALL		DIRENT				; tell the drive our filename
		JNZ			errFF				; DIRENT returned file exists err  (was AE)
		;JNZ			errDE				; dest file already exists on disk
		LDA			FX1					; read 1st byte of filename ext
		CPI			'B'					; compare to 'B'
		JC			errSN				; reject if less than 'B'  (was NM)
		CPI			'E'					; compare to 'E'
		JNC			errSN				; reject if not less than 'E'  (was NM)
		CALL		FINDFN				; find the start of the file in ram
		; Z = not found, NZ = found
		; HL: Pointer to file's dir entry
		; DE: Points to start of file in RAM
		; A: Contains file attribute
		; BC: Unchanged
		JZ			errFF				; file not found in RAM
		;JZ			errSE				; src file not found in RAM
		CALL		GetFtypeX			; get ftype for AFTEREOF2
		; CO: A=0 F=ZP
		; DO: A=1
		; BA: A=2 F=SPC

; This ftype 0/1/2 stuff is confusing to read because the ftype value is being
; used in two different ways with two different meanings. What's going on is
; one sequence of three values just happens to be a mirror image of the other,
; and I guess it saved a few bytes to capitalize on the coincidence.
;
; MKDIRENT ftype is 0=BA, 1=DO, 2=CO
; And it just happens to also be that:
; For ftype 0 (BA) the rom adds 2 bytes to mark EOF: 0x00 0x00
; For ftype 1 (DO) the rom adds 1 byte to mark EOF: 0x1A
; For ftype 2 (CO) the rom adds 0 bytes to mark EOF: the file is defined by the CO header
;
; So it just happens to coincidentally be that: true_fsize = ram_fsize-(2-ftype)

		MOV			C,A					; C = ftypeX
		; CO: C=0
		; DO: C=1
		; BA: C=2
		MVI			A,ftypeCO			; A = ftypeCO = 2
		SUB			C					; A = 2 - ftypeX
		; CO: A = 2-0 = 2
		; DO: A = 2-1 = 1
		; BA: A = 2-2 = 0
		PUSH		B					; stash BC (B=0? C=ftypeX)
		PUSH		D					; stash DE (start of file in ram)
		; DE = start of file data
		; HL = start of file dirent
		XCHG							; swap HL:DE
		; DE = start of file dirent
		; HL = start of file data
		; BA: A = 0
		; DO: A = 1
		; CO: A = 2
		CALL		AFTEREOF2			; Advance HL past end of current file based on type in A: 0=BA, 1=DO, 2=CO
		POP			D					; restore DE = start of file data
		MOV			A,L					; A = eof lsb
		SUB			E					; A = eof lsb - sof lsb
		MOV			L,A					; L = A
		MOV			A,H					; A = eof msb
		SBB			D					; A = eof msb - sof msb
		MOV			H,A					; H = A
		; HL = eof-sof = file length
		POP			B					; retore B=0 C=ftypeX  CO:0  DO:1  BA:2
		; Add 1 to both C and HL before entering the following loop because we don't
		; hit the first JNZ until after running the body at least once.
		INR			C					; C++
		INX			H					; HL++
@l0:	; remove 0/1/2 eof marker bytes from ram filesize to get true filesize
		DCX			H					; HL-- = length--
		DCR			C					; C-- = 
		JNZ			@l0
		MOV			A,L					; A = len lsb
		ORA			H					; len msbVlsb, aka set Z if len=0
		RZ								; if file len=0 then there's nothing to do
		PUSH		D					; TS[0] = DE = sof
		PUSH		H					; TS[0] HL = true_len, TS[1] = sof
		CALL		SendOpenCMD_write	; tell drive to open the file for write
		POP			D					; DE = true_len
		POP			H					; HL = sof
		CALL		WriteChunks			; send WRITE packets
		MVI			A,cmd_close			; A = cmd_close
		;JMP			ShortPacket			; fall through to send CLOSE packet

; Build & send a short packet (commands that have no data payload)
; A = cmd
ShortPacket:
		CALL		InitPacket
jSendPacket:
		CALL		SendPacket
		RZ			; return if return packet DLEN is 0 (some commands return no data)
		; otherwise, decode the result byte
		; A = error code return data from drive, the first & only byte of pktDATA
	IF ERRS
ParseStdReturn:
		; A has an error code sent in the data field of the return packet
		; see dl2/constants.h
		ANI			0xF0		; A &= 0xF0
		RAR						; Rotate Accumulator Right through carry
		RAR						; Rotate Accumulator Right through carry
		RAR						; Rotate Accumulator Right through carry
		MOV			E,A			; E = eXX offset into STR_ErrCodes
		JMP			ERROR
	ENDIF

; HL = sof   start of file
; DE = len   length of file
WriteChunks:
		PUSH		H					; TS[0] = position_a
		PUSH		H					; TS[0] = position_a TS[1] = position_a
		LXI			H,CHUNK_LEN			; HL = CHUNK_LEN
		_RST		rst_CompareDEHL		; compare DE(remaining_len) to HL(chunk_len)
		; flags: C if HL<DE, Z if HL=DE, else HL>DE, only A is destroyed
		JNC			@end				; exit loop when CHUNK_LEN >= remaining_len
		MOV			C,L					; C = L = CHUNK_LEN
		MOV			B,H					; B = H = 0, BC = CHUNK_LEN = 0x0080
		POP			H					; HL = position_a, TS[0] = position_a
		DAD			B					; HL = HL+BC = position_a + CHUNK_LEN = position_b
		XTHL							; swap TS:HL -> TS[0] = position_b, HL = position_a
		XCHG							; swap HL:DE -> DE = position_a, HL = remaining_len

		; subtract CHUNK_LEN from remaining_len by adding 0xFFFF-CHUNK_LEN+1
		LXI			B,0xFFFF-CHUNK_LEN+1	; BC = 0xFF80
		DAD			B					; HL += BC, iow HL -= CHUNK_LEN
		; HL = (new, smaller) remaining_len
		PUSH		H					; TS[0] = remaining_len  TS[1] = position_b

		; HL = remaining_len
		; BC = 0xFF80 (what matters next is only that C = CHUNK_LEN)
		; DE = position_a
		CALL		SendWriteCMD

		; setup for next chunk
		POP			D					; DE = remaining_len, TS[0] = position_b
		POP			H					; HL = position_b
		; HL = new higher start position, DE = new shorter length
		JMP			WriteChunks
@end:
		MOV			C,E					; C = remaining_len
		POP			H					; HL = position_a ; TS[0] = position_a
		JMP			SendFinalWriteChunk

STR_Prompt:
		DB			"> C FFFFFF.XX (C=KLSQ)",CR,LF,"> ",0

STR_Err:
	IF ERRS
		DB			" Err",CR,LF,0,"FFUESNIOWPDFNDHW"
	ELSE
		DB			"ERR",CR,LF,0
	ENDIF

	IF ERRS
STR_ErrCodes		EQU STR_Err+5

; Offsets into STR_ErrCodes. Drive returns 0x00-0x8F -> ParseStdReturn -> eXX
; see ParseStdReturn & dl2/constants.h
eFF					EQU		0x02 ; directory - file not found, file already exist
eUE					EQU		0x04 ; unknown - 0x20-0x2F, never observed, maybe use this spot for a local-only error
eSN					EQU		0x06 ; syntax
eIO					EQU		0x08 ; integrity - crc & other data sanity failures, disk/serial/ram
eWP					EQU		0x0A ; write-protect, format
eDF					EQU		0x0C ; bounds - dir/file/disk full/exceeded
eND					EQU		0x0E ; presense - disk changed / not inserted
eHW					EQU		0x10 ; hardware - physical drive or disk problems
	ENDIF

PRGEND:
